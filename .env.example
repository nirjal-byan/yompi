NODE_ENV=development

# Application ports
API_PORT=3001
WEB_PORT=3000

# PostgreSQL / PostGIS container
POSTGRES_DB=yompi_db
POSTGRES_USER=yompi_admin
POSTGRES_PASSWORD=yompi_password
POSTGRES_PORT=5432

# Prisma connection string
DATABASE_URL=postgresql://yompi_admin:yompi_password@localhost:5432/yompi_db?schema=public

# Optional frontend config
NEXT_PUBLIC_API_URL=http://localhost:3001

# URLs (used for CORS, redirects and the sign-in link in emails)
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# SMTP (dev default: Mailpit container, inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=YOMPI <no-reply@yompi.local>

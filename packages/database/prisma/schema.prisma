generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum AccommodationTier {
  BUDGET
  STANDARD
  COMFORT
}

enum ConditionCategory {
  WEATHER
  OFFICIAL_ADVISORY
  TRAIL_REPORT
}

model Region {
  id           String                                  @id @default(uuid())
  slug         String                                  @unique
  name         String
  description  String
  boundary     Unsupported("geometry(Polygon, 4326)")?
  destinations Destination[]
  createdAt    DateTime                                @default(now())
  updatedAt    DateTime                                @updatedAt
}

model Destination {
  id                 String                                @id @default(uuid())
  slug               String                                @unique
  name               String
  tagline            String
  description        String
  maxElevationM      Int
  difficultyStars    Int
  difficultyCriteria String
  scenicStars        Int
  standardDays       Int
  bestSeasons        String[]
  permitsRequired    String[]
  mapSpriteKey       String
  mapX               Float
  mapY               Float
  coordinates        Unsupported("geometry(Point, 4326)")?

  permitCostPerPersonNpr    Int
  transportCostPerPersonNpr Int
  guideDailyRateNpr         Int
  porterDailyRateNpr        Int
  foodDailyPerPersonNpr     Int

  regionId       String
  region         Region            @relation(fields: [regionId], references: [id])
  checkpoints    RouteCheckpoint[]
  accommodations Accommodation[]
  conditions     TrailCondition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RouteCheckpoint {
  id             String                                @id @default(uuid())
  dayNumber      Int
  orderIndex     Int
  name           String
  elevationM     Int
  distanceKm     Float
  walkingHours   Float
  elevationGainM Int
  elevationLossM Int
  notes          String?
  coordinates    Unsupported("geometry(Point, 4326)")?

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

model Accommodation {
  id               String            @id @default(uuid())
  name             String
  tier             AccommodationTier
  pricePerNightNpr Int
  checkpointName   String
  distanceToNextKm Float?
  facilities       String[]
  contactPhone     String?
  lastVerifiedAt   DateTime          @default(now())

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

model TrailCondition {
  id                 String            @id @default(uuid())
  category           ConditionCategory
  title              String
  summary            String
  sourceName         String
  sourceUrl          String?
  geographicCoverage String
  confidenceLevel    String
  reportedAt         DateTime          @default(now())

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model LoginToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  email     String
  name      String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum GeoFeatureKind {
  COUNTRY_BOUNDARY
  PEAK
  CITY
  GATEWAY
  TRAIL
  LAKE
  PASS
}

model DataSource {
  id          String       @id @default(uuid())
  key         String       @unique
  name        String
  url         String
  license     String
  attribution String
  features    GeoFeature[]
}

model GeoFeature {
  id         String                                  @id @default(uuid())
  kind       GeoFeatureKind
  name       String
  nameLocal  String?
  elevationM Int?
  properties Json?
  geometry   Unsupported("geometry(Geometry, 4326)")
  sourceId   String
  source     DataSource                              @relation(fields: [sourceId], references: [id])
  sourceRef  String
  fetchedAt  DateTime                                @default(now())
  treks      Trek[]

  @@unique([sourceId, sourceRef])
  @@index([kind])
  @@index([geometry], type: Gist)
}

enum PermitUnit {
  PER_PERSON
  PER_PERSON_PER_DAY
  PER_GROUP
}

enum CostCategory {
  GUIDE_DAILY
  PORTER_DAILY
  FOOD_DAILY
  LODGING_BUDGET
  LODGING_STANDARD
  LODGING_COMFORT
  TRANSPORT
  OTHER
}

enum CostUnit {
  PER_DAY
  PER_NIGHT
  PER_PERSON
  PER_TRIP
}

model Trek {
  id            String       @id @default(uuid())
  slug          String       @unique
  name          String
  region        String
  trailId       String?
  trail         GeoFeature?  @relation(fields: [trailId], references: [id], onDelete: SetNull)
  minDays       Int
  maxDays       Int
  highestPointM Int?
  startPlace    String?
  endPlace      String?
  notes         String?
  sourceName    String
  sourceUrl     String
  verifiedAt    DateTime
  permits       TrekPermit[]
  costs         CostItem[]
  stays         Stay[]
  conditions    Condition[]
  itinerary     ItineraryDay[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Permit {
  id         String       @id @default(uuid())
  slug       String       @unique
  name       String
  authority  String
  appliesTo  String
  amountNpr  Int
  unit       PermitUnit
  notes      String?
  sourceName String
  sourceUrl  String
  verifiedAt DateTime
  treks      TrekPermit[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model TrekPermit {
  trekId   String
  permitId String
  trek     Trek   @relation(fields: [trekId], references: [id], onDelete: Cascade)
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  @@id([trekId, permitId])
}

model CostItem {
  id         String       @id @default(uuid())
  slug       String       @unique
  category   CostCategory
  label      String
  amountNpr  Int
  unit       CostUnit
  trekId     String?
  trek       Trek?        @relation(fields: [trekId], references: [id], onDelete: Cascade)
  notes      String?
  sourceName String
  sourceUrl  String
  verifiedAt DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Stay {
  id               String            @id @default(uuid())
  slug             String            @unique
  name             String
  place            String
  trekId           String
  trek             Trek              @relation(fields: [trekId], references: [id], onDelete: Cascade)
  tier             AccommodationTier
  pricePerNightNpr Int?
  elevationM       Int?
  notes            String?
  sourceName       String
  sourceUrl        String
  verifiedAt       DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([trekId])
}

model Condition {
  id         String            @id @default(uuid())
  slug       String            @unique
  title      String
  summary    String
  category   ConditionCategory
  trekId     String?
  trek       Trek?             @relation(fields: [trekId], references: [id], onDelete: SetNull)
  sourceName String
  sourceUrl  String
  verifiedAt DateTime
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([trekId])
}

model ItineraryDay {
  id                  String   @id @default(uuid())
  slug                String   @unique
  trekId              String
  trek                Trek     @relation(fields: [trekId], references: [id], onDelete: Cascade)
  dayNumber           Int
  title               String
  fromPlace           String
  toPlace             String
  overnightPlace      String?
  overnightElevationM Int?
  hoursText           String?
  notes               String?
  sourceName          String
  sourceUrl           String
  verifiedAt          DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([trekId, dayNumber])
}

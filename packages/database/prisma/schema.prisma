generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum AccommodationTier {
  BUDGET
  STANDARD
  COMFORT
}

enum ConditionCategory {
  WEATHER
  OFFICIAL_ADVISORY
  TRAIL_REPORT
}

model Region {
  id           String        @id @default(uuid())
  slug         String        @unique
  name         String
  description  String
  boundary     Unsupported("geometry(Polygon, 4326)")?
  destinations Destination[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Destination {
  id                 String            @id @default(uuid())
  slug               String            @unique
  name               String
  tagline            String
  description        String
  maxElevationM      Int
  difficultyStars    Int               // 1-5
  difficultyCriteria String            // Explains terrain, altitude & technical requirements
  scenicStars        Int               // 1-5
  standardDays       Int
  bestSeasons        String[]
  permitsRequired    String[]
  mapSpriteKey       String            // Links to PixiJS asset key
  mapX               Float             // Illustrated 2D map X coordinate
  mapY               Float             // Illustrated 2D map Y coordinate
  coordinates        Unsupported("geometry(Point, 4326)")?

  // Pricing parameters in NPR for accurate group calculations
  permitCostPerPersonNpr    Int
  transportCostPerPersonNpr Int
  guideDailyRateNpr         Int
  porterDailyRateNpr        Int
  foodDailyPerPersonNpr     Int

  regionId       String
  region         Region            @relation(fields: [regionId], references: [id])
  checkpoints    RouteCheckpoint[]
  accommodations Accommodation[]
  conditions     TrailCondition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RouteCheckpoint {
  id             String      @id @default(uuid())
  dayNumber      Int
  orderIndex     Int
  name           String
  elevationM     Int
  distanceKm     Float
  walkingHours   Float
  elevationGainM Int
  elevationLossM Int
  notes          String?
  coordinates    Unsupported("geometry(Point, 4326)")?

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

model Accommodation {
  id                String            @id @default(uuid())
  name              String
  tier              AccommodationTier
  pricePerNightNpr  Int
  checkpointName    String
  distanceToNextKm  Float?
  facilities        String[]
  contactPhone      String?
  lastVerifiedAt    DateTime          @default(now())

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

model TrailCondition {
  id                 String            @id @default(uuid())
  category           ConditionCategory
  title              String
  summary            String
  sourceName         String
  sourceUrl          String?
  geographicCoverage String
  confidenceLevel    String            // e.g. "HIGH", "MODERATE", "LOCAL_REPORT"
  reportedAt         DateTime          @default(now())

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// One-time sign-in link. Only the SHA-256 hash of the token is stored.
model LoginToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  email     String
  name      String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

// Server-side session. Only the SHA-256 hash of the cookie token is stored.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---- Real-world geodata (drives the Nepal map) ----

enum GeoFeatureKind {
  COUNTRY_BOUNDARY
  PEAK
  CITY
  GATEWAY
  TRAIL
  LAKE
  PASS
}

// Where a dataset came from. Attribution must be shown wherever the data is displayed.
model DataSource {
  id          String       @id @default(uuid())
  key         String       @unique
  name        String
  url         String
  license     String
  attribution String
  features    GeoFeature[]
}

// One row per real-world feature, in WGS84 lon/lat. Visual map styling lives in the frontend.
model GeoFeature {
  id         String                              @id @default(uuid())
  kind       GeoFeatureKind
  name       String
  nameLocal  String?
  elevationM Int?
  properties Json?
  geometry   Unsupported("geometry(Geometry, 4326)")
  sourceId   String
  source     DataSource                          @relation(fields: [sourceId], references: [id])
  sourceRef  String
  fetchedAt  DateTime                            @default(now())

  @@unique([sourceId, sourceRef])
  @@index([kind])
  @@index([geometry], type: Gist)
}

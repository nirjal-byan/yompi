{
  "name": "yompi",
  "private": true,
  "version": "1.0.0",
  "description": "YOMPI monorepo for the Nepal trekking discovery platform.",
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @yompi/database exec prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "pnpm --filter @yompi/database exec prisma migrate dev --schema=./prisma/schema.prisma",
    "db:push": "pnpm --filter @yompi/database exec prisma db push --schema=./prisma/schema.prisma",
    "db:studio": "pnpm --filter @yompi/database exec prisma studio --schema=./prisma/schema.prisma",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:import-geo": "pnpm --filter @yompi/database run import-geo"
  },
  "devDependencies": {
    "turbo": "^2.11.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
